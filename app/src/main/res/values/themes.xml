<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material 3 浅色主题：品牌主色 #4A5BD8，卡片白底、页面浅紫灰底。 -->
    <style name="GeminiLight" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/gm_primary</item>
        <item name="colorOnPrimary">@color/gm_on_primary</item>
        <item name="colorPrimaryContainer">@color/gm_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/gm_on_primary_container</item>
        <item name="colorSecondary">@color/gm_primary</item>
        <item name="colorOnSecondary">@color/gm_on_primary</item>
        <item name="colorSecondaryContainer">@color/gm_primary_container</item>
        <item name="colorOnSecondaryContainer">@color/gm_on_primary_container</item>
        <item name="colorSurface">@color/gm_surface</item>
        <item name="colorOnSurface">@color/gm_on_surface</item>
        <item name="colorSurfaceVariant">@color/gm_secondary_container</item>
        <item name="colorOnSurfaceVariant">@color/gm_on_surface_variant</item>
        <item name="colorOutline">@color/gm_outline</item>
        <item name="colorOutlineVariant">@color/gm_outline_variant</item>
        <item name="colorError">@color/gm_error</item>
        <item name="android:colorBackground">@color/gm_surface</item>
        <item name="android:windowBackground">@color/gm_surface</item>
        <item name="android:statusBarColor">@color/gm_surface</item>
        <item name="android:navigationBarColor">@color/gm_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="materialCardViewStyle">@style/Widget.GM.Card</item>
        <item name="materialButtonStyle">@style/Widget.GM.Button</item>
    </style>

    <style name="Widget.GM.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/gm_surface_container</item>
        <item name="strokeColor">@color/gm_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.GM.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">26dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.GM.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/gm_primary_container</item>
        <item name="shapeAppearance">@style/ShapeAppearance.GM.Pill</item>
    </style>

    <style name="ShapeAppearance.GM.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
